{
  "name": "rock-racing-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets:prepare": "node scripts/prepareVehicleAssets.js",
    "test": "playwright test",
    "test:smoke": "playwright test --project=desktop --grep \"produção em 4183\" --retries=0 --max-failures=1 --timeout=60000",
    "test:race": "node --test tests/race-simulation.unit.js",
    "test:camera": "node --test tests/race-camera.unit.js tests/track-assignment.unit.js",
    "test:controls": "node --test tests/player-controls.unit.js",
    "test:championship": "node --test tests/championship.unit.js tests/championship-service.unit.js",
    "test:championship:flow": "playwright test --project=desktop tests/championship-flow.spec.js --retries=0 --max-failures=1 --timeout=75000",
    "test:camera:rig": "node --test --test-timeout=15000 tests/race-camera.unit.js",
    "test:tracks": "node --test --test-timeout=15000 tests/track-assignment.unit.js",
    "test:vehicles": "node --test --test-timeout=15000 tests/buggy-visual.unit.js",
    "test:particles": "node --test --test-timeout=15000 tests/tire-smoke.unit.js",
    "test:save": "node --test --test-timeout=15000 --test-name-pattern=\"^(storage |migração de save|migração desconhecida|versão :v2|nenhum backup|falha no backup|falha no principal|conflito entre abas|save rejeita)\" tests/championship.unit.js",
    "test:save:erase": "node --test --test-timeout=15000 --test-name-pattern=\"^(apagar progresso|falha ao excluir backup|falha parcial na exclusão)\" tests/championship-service.unit.js",
    "test:ui:erase": "playwright test --project=desktop tests/erase-progress.spec.js --retries=0 --max-failures=1 --timeout=60000",
    "test:ui:credits": "playwright test --project=desktop tests/public-credits.spec.js --retries=0 --max-failures=1 --timeout=30000",
    "test:vehicles:flow": "playwright test --project=desktop tests/local-buggy.spec.js --retries=0 --max-failures=1 --timeout=150000",
    "test:integration:race": "playwright test --project=desktop tests/race-flow.spec.js --retries=0 --max-failures=1 --timeout=120000"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
